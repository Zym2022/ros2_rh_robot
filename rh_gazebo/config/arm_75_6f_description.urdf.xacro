<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_75_description">

    <!-- Import claw_description urdf file -->
    <xacro:include filename="$(find rm_description)/urdf/rm_75_gazebo.urdf.xacro" link7_type="Link7_6f"/>


    <!-- 对一些link进行gazebo的属性设置 -->
    <gazebo reference="base_link">
        <self_collide>false</self_collide>
        <gravity>true</gravity>
    </gazebo>
    <gazebo reference="Link1">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>true</gravity>
    </gazebo>
    <gazebo reference="Link2">
        <material>Gazebo/White</material>
        <gravity>true</gravity>
    </gazebo>
    <gazebo reference="Link3">
        <material>Gazebo/White</material>
        <gravity>true</gravity>
    </gazebo>
    <gazebo reference="Link4">
        <material>Gazebo/White</material>
        <gravity>true</gravity>
    </gazebo>
    <gazebo reference="Link5">
        <material>Gazebo/White</material>
        <gravity>true</gravity>
    </gazebo>
    <gazebo reference="Link6">
        <material>Gazebo/White</material>
        <gravity>true</gravity>
    </gazebo>
    <gazebo reference="Link7">
        <material>Gazebo/White</material>
        <gravity>true</gravity>
    </gazebo>


    <gazebo>
        <is_static>true</is_static>
        <self_collide>true</self_collide>
    </gazebo>


    <!-- 声明ros2_control -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="joint1">
            <!-- <command_interface name="position"/> -->
            <command_interface name="velocity">
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint2">
            <!-- <command_interface name="position"/> -->
            <command_interface name="velocity">
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">-0.97350057</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint3">
            <!-- <command_interface name="position"/> -->
            <command_interface name="velocity">
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.021603100615739824</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint4">
            <!-- <command_interface name="position"/> -->
            <command_interface name="velocity">
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.8</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint5">
            <!-- <command_interface name="position"/>-->
            <command_interface name="velocity">
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">-0.023854149717092515</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint6">
            <!-- <command_interface name="position"/> -->
            <command_interface name="velocity">
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.5</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint7">
            <!-- <command_interface name="position"/> -->
            <command_interface name="velocity">
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">3.1415</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <!-- 加载ros2_control插件 -->
    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <parameters>$(find rh_gazebo)/config/gazebo_controllers.yaml</parameters>
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
        </plugin>
    </gazebo>


</robot>

