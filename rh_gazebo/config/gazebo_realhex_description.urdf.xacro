<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rh_description">
    <!-- 包含 rm_gazebo 的 xacro 文件，并传递参数 -->
    <xacro:include filename="$(find rh_gazebo)/config/arm_75_6f_description.urdf.xacro"/>

    <xacro:include filename="$(find inspire_description)/urdf/inspire_gripper.urdf.xacro"/>
    <xacro:gripper parent_link="Link7"/>

    <xacro:include filename="$(find xpkg_urdf_echo_plus)/urdf/sim_base.xacro"/>

    <joint name="arm_base_joint" type="fixed">
        <parent link="mobile_base"/>
        <child link="base_link"/>
        <origin xyz="0.02171 0 0.36" rpy="0 0 0"/>
    </joint>

    <!-- 加载全局相机
    <xacro:include filename="$(find rm_description)/urdf/sensors/camera_gazebo.xacro"/>
    
    <joint name="head_joint" type="fixed">
        <parent link="base_link"/>
        <child link="head_link"/>
        <origin xyz="0.2 0 0.3" rpy="0 0 0"/>
    </joint>
    <xacro:usb_camera prefix="head" type="depth" width="640" height="480" fps="30"/> -->

</robot>