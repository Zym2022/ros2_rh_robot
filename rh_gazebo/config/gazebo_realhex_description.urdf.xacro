<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rh_description">
    <xacro:arg name="base_link_name" default="rm_base_link"/>
    <xacro:arg name="fixed_to_world" default="no"/>
    <!-- 包含 rm_gazebo 的 xacro 文件，并传递参数 -->
    <xacro:include filename="$(find rm_gazebo)/config/gazebo_75_6f_description.urdf.xacro">
        <xacro:arg name="base_link_name" value="$(arg base_link_name)"/>
        <xacro:arg name="fixed_to_world" value="$(arg fixed_to_world)"/>
    </xacro:include>

    <xacro:include filename="$(find xpkg_urdf_echo_plus)/urdf/sim_base.xacro"/>

    <joint name="arm_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="$(arg base_link_name)"/>
        <origin xyz="0.02171 0 0.36" rpy="0 0 0"/>
    </joint>

</robot>