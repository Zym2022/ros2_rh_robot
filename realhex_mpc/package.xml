<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>realhex_mpc</name>
  <version>0.1.0</version>
  <description>MPC接口用于连接OCS2 MPC控制器与RealHex机器人的Gazebo仿真</description>
  <maintainer email="your-email@example.com">Zhuyiming</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>ocs2_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ocs2_core</depend>
  <depend>ocs2_mpc</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package> 